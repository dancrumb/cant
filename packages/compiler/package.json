{
  "name": "@dancrumb/cant-compiler",
  "version": "0.10.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dancrumb/cant.git",
    "directory": "packages/compiler"
  },
  "description": "The cant compiler",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cant": "./dist/cli.js",
    "weave": "./dist/weave.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dancrumb/cant-shared": "workspace:^",
    "commander": "^15.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/unist": "^3.0.3",
    "tsx": "^4.23.15"
  }
}
