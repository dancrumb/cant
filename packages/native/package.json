{
  "name": "@dancrumb/cant-native",
  "version": "0.17.0",
  "private": true,
  "description": "The API that native Cant modules are written against: CantError, CantDuration and CantFile",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint ."
  }
}
