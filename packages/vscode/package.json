{
  "name": "cant-vscode",
  "displayName": "Cant",
  "version": "0.15.0",
  "private": true,
  "description": "Language support for Cant: problems, go to definition, references, hover, outline and completion, and highlighting, including cant code blocks in Markdown",
  "license": "MIT",
  "publisher": "wasakatechnologies",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#16181D",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dancrumb/cant.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/dancrumb/cant/issues"
  },
  "homepage": "https://github.com/dancrumb/cant#readme",
  "keywords": [
    "cant",
    "language server",
    "lsp"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cant",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cant.restartServer",
        "title": "Restart Language Server",
        "category": "Cant"
      }
    ],
    "languages": [
      {
        "id": "cant",
        "aliases": [
          "Cant",
          "cant"
        ],
        "extensions": [
          ".cant"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-light.svg",
          "dark": "./images/file-dark.svg"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs --log-level=warning && esbuild @dancrumb/cant-lsp/server --bundle --platform=node --format=cjs --outfile=dist/server.cjs --log-level=warning",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "vsce package --no-dependencies --out dist/cant.vsix",
    "publish:marketplace": "vsce publish --no-dependencies --packagePath dist/cant.vsix"
  },
  "devDependencies": {
    "@dancrumb/cant-lsp": "workspace:^",
    "@dancrumb/cant-shared": "workspace:^",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vscode-languageclient": "^11.0.0"
  }
}
