{
  "name": "@dancrumb/cant-shared",
  "version": "0.10.0",
  "description": "Shared code for the cant compiler, interpreter and language server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "peggy --format es --dts -o src/generated/parser.js src/cant.peggy",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@types/unist": "^3.0.3",
    "tokenizr": "^2.2.1",
    "unist-builder": "^4.0.0"
  },
  "devDependencies": {
    "peggy": "^5.1.1"
  }
}
