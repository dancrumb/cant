{
  "name": "@dancrumb/cant-shared",
  "version": "0.1.0",
  "description": "Shared code for the cant compiler, interpreter and language server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test \"dist/**/*.test.js\"",
    "lint": "eslint ."
  }
}
