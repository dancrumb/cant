{
  "name": "@dancrumb/cant-lsp",
  "version": "0.3.2",
  "description": "The cant language server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dancrumb/cant-shared": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint ."
  }
}
