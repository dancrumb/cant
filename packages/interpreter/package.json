{
  "name": "@dancrumb/cant-interpreter",
  "version": "0.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dancrumb/cant.git",
    "directory": "packages/interpreter"
  },
  "description": "The cant interpreter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dancrumb/cant-shared": "workspace:^",
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@dancrumb/cant-shared --external:date-fns --external:@date-fns/tz --log-level=warning",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@dancrumb/cant-native": "workspace:^",
    "esbuild": "^0.28.2"
  }
}