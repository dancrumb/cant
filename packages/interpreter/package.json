{
  "name": "@dancrumb/cant-interpreter",
  "version": "0.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dancrumb/cant.git",
    "directory": "packages/interpreter"
  },
  "description": "The cant interpreter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dancrumb/cant-shared": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  }
}
