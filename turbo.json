{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js"
  ],
  "tasks": {
    "generate": {
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
